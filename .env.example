# Client-safe build configuration
VITE_API_URL=
VITE_APP_ENV=development

# Server runtime
APP_ENV=development
NODE_ENV=development
PORT=3000
PGPOOL_MAX=10

# PostgreSQL - server only
DATABASE_URL=

# Telegram Mini App authentication - server only
TELEGRAM_BOT_TOKEN=
TELEGRAM_INITDATA_MAX_AGE_SECONDS=3600

# Explicit browser origins allowed to send credentialed requests
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174

# Server secrets only. Never expose through VITE_* variables.
SESSION_SECRET=
JWT_SECRET=
